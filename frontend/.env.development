# Used ONLY by `npm start` (the CRA dev server on :3000).
#
# The dev server serves the React app but has no API of its own, so a
# relative "/api" would hit :3000 and 404. This points it at the Laravel
# backend instead.
#
# Two ways to run the backend in development, and this must match the
# one you use:
#
#   php artisan serve        -> http://localhost:8000/api   (the default below)
#   Apache virtual host      -> http://ceb-uva.test/api
#
# Whichever you pick, the same origin must be listed in the backend's
# config/cors.php and in SANCTUM_STATEFUL_DOMAINS in backend/.env, or
# the browser blocks every request before Laravel ever sees it.
#
# The production build ignores this file entirely and uses a relative
# "/api", because Apache serves the app and the API from one origin.

REACT_APP_API_BASE_URL=http://localhost:8000/api
